# ADS Admin System - Production Environment Configuration
# Copy this file to /etc/ads-admin/production.env on your Hostinger VPS
# DO NOT commit this file to Git with actual passwords!

# ====================================
# Database Configuration (REQUIRED)
# ====================================
DATABASE_URL=jdbc:postgresql://localhost:5432/ads_production
DATABASE_USERNAME=ads_user
DATABASE_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# Database Pool Settings
DB_POOL_SIZE=10
DB_POOL_MIN=2

# ====================================
# Admin Account Configuration (REQUIRED)
# ====================================
ADMIN_DEFAULT_EMAIL=admin@yourdomain.com
ADMIN_DEFAULT_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_FULLNAME=System Administrator

# ====================================
# Application Configuration
# ====================================
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ====================================
# Security Configuration (REQUIRED for HTTPS)
# ====================================
COOKIE_SECURE=true
THYMELEAF_CACHE=true

# ====================================
# JPA/Hibernate Configuration
# ====================================
# Use 'validate' in production to prevent automatic schema changes
# Use 'update' only during initial setup if you trust auto-migrations
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# ====================================
# Logging Configuration
# ====================================
LOG_LEVEL=INFO

# ====================================
# JVM Options (Tune based on your VPS specs)
# ====================================
# For 2GB VPS: -Xmx1024m -Xms512m
# For 4GB VPS: -Xmx2048m -Xms1024m
JAVA_OPTS=-Xmx1024m -Xms512m -XX:+UseG1GC -XX:MaxRAMPercentage=75.0 -XX:+DisableExplicitGC

# ====================================
# Optional: Application Insights / Monitoring
# ====================================
# Uncomment if you want to add external monitoring
# APPINSIGHTS_INSTRUMENTATIONKEY=your-key-here
# NEWRELIC_LICENSE_KEY=your-key-here

# ====================================
# NOTES:
# ====================================
# 1. Replace all CHANGE_THIS_TO_STRONG_PASSWORD with actual strong passwords
# 2. Use passwords with at least 16 characters, including:
#    - Uppercase and lowercase letters
#    - Numbers
#    - Special characters (!@#$%^&*)
# 3. Set proper file permissions: sudo chmod 600 /etc/ads-admin/production.env
# 4. Set ownership: sudo chown ads-admin:ads-admin /etc/ads-admin/production.env
# 5. Never commit this file with real credentials to Git

