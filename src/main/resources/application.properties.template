# Application Configuration Template
# Copy this file to application.properties and fill in your values
# DO NOT commit application.properties with real credentials to Git!

# Database Configuration
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/ADS
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD:}

# JPA Configuration
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.hibernate.format_sql=true

# Thymeleaf Configuration
spring.thymeleaf.cache=false
spring.thymeleaf.prefix=classpath:/templates/
spring.thymeleaf.suffix=.html

# Server Configuration
server.port=8081

# Admin Configuration (Environment Variables Recommended)
# These will only work if set. Leave empty to use environment variables.
admin.default.email=${ADMIN_DEFAULT_EMAIL:}
admin.default.password=${ADMIN_DEFAULT_PASSWORD:}
admin.default.username=${ADMIN_DEFAULT_USERNAME:}
admin.default.fullname=${ADMIN_DEFAULT_FULLNAME:}

# Logging
logging.level.com.ads.admin=INFO
logging.level.org.springframework.security=DEBUG

